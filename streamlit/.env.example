GCP_PROJECT=ecommerce-analytics-495218
BIGQUERY_LOCATION=asia-southeast1
BIGQUERY_DATASET=warehouse_ecommerce
BIGQUERY_TABLE=fct_orders

# Local mode: free to run on your own machine, not suitable for public hosted access.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# Hosted mode on Google Cloud: uses Vertex AI Gemini with Application Default Credentials
# locally, or a service account when deployed.
# LLM_PROVIDER=google
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash

MAX_RESULT_ROWS=500
